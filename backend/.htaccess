<IfModule mod_rewrite.c>
    RewriteEngine On

    # Izinkan akses langsung ke file atau direktori yang benar-benar ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Arahkan seluruh request lainnya ke index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Pengaturan Keamanan
Options -Indexes
