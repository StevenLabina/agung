# =============================================================================
# KONFIGURASI ENVIRONMENT BACKEND OCR KTP
# =============================================================================

# Konfigurasi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ocr_ktp
DB_USER=root
DB_PASS=

# Path Eksekusi Python (opsional: jika dikosongkan, backend otomatis mendeteksi folder backend/venv/ atau venv/ di project)
# Contoh Windows: backend/venv/Scripts/python.exe
# Contoh Linux / Server: backend/venv/bin/python
PYTHON_PATH=

# Lingkungan Aplikasi
APP_ENV=local
APP_DEBUG=true
