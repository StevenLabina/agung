# =============================================================================
# KONFIGURASI ENVIRONMENT BACKEND OCR KTP
# =============================================================================

# Konfigurasi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ocr_ktp
DB_USER=root
DB_PASS=

# Path Eksekusi Python (opsional, kosongkan untuk menggunakan default sistem)
PYTHON_PATH=python

# Lingkungan Aplikasi
APP_ENV=local
APP_DEBUG=true
